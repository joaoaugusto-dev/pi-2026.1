# Supabase
# URL do projeto, encontrada em Project Settings > API.
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anon/public do projeto. Não use service_role no app mobile.
SUPABASE_ANON_KEY=sua-chave-anon-publica

# Nome exato da tabela criada pelo script supabase/schema.sql.
SUPABASE_MEASUREMENTS_TABLE=measurement_records

# Nome exato do bucket privado criado pelo script supabase/schema.sql.
SUPABASE_IMAGES_BUCKET=measurement-images

# Ollama
# Precisa ser uma URL pública HTTPS. O app rejeita localhost, IP interno e HTTP.
OLLAMA_BASE_URL=https://seu-endpoint-ollama.example.com

# Modelo disponível no servidor Ollama configurado acima.
OLLAMA_MODEL=llama3.1
